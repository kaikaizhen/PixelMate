# 容器內的靜態站設定。nginx 官方映像啟動時會把 ${PORT} 代入。
# 對外的 TLS / 網域 / 路由由主機端的反向代理處理。
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    # Cloudflare 會自動注入 Web Analytics（beacon）與一段行內腳本，需放行其來源與雜湊
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-KRKxD3XOy9IWcAZhw3ag9GJy8JgvWTPBXZbU593b2xI=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'" always;

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # 雜湊檔名的資源可長期快取（子 location 需重複安全標頭）
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-KRKxD3XOy9IWcAZhw3ag9GJy8JgvWTPBXZbU593b2xI=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'" always;
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-KRKxD3XOy9IWcAZhw3ag9GJy8JgvWTPBXZbU593b2xI=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'" always;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
