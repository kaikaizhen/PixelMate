# Copy values into user-secrets (dev) or real environment variables (prod). Never commit the real values.
# dotnet user-secrets set "ConnectionStrings:Default" "Server=<host>;Port=3306;Database=<schema>;Uid=<user>;Pwd=<password>" --project src/PixelMate.Api
ConnectionStrings__Default=Server=localhost;Port=3306;Database=pixelmate;Uid=pixelmate;Pwd=change-me

# Gmail SMTP. Use a Google "App password" (needs 2-step verification), not the account password.
Mail__Username=kaikaizhennas@gmail.com
Mail__Password=your-16-char-app-password
Mail__FromAddress=kaikaizhennas@gmail.com
Mail__FromName=小伴星 PixelMate

# Links inside e-mails point here (the web app). Turn confirmation on once mail works.
Auth__WebBaseUrl=https://pixelmate.name404.com/web
Auth__RequireConfirmedEmail=false
Auth__SecureCookie=true

Cors__AllowedOrigins__0=https://pixelmate.name404.com
RateLimit__PermitPerMinute=120
RateLimit__AuthPerMinute=10
Health__ExposeDb=false
